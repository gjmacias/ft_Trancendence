[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
x509_extensions    = v3_ext
distinguished_name = dn

[ dn ]
C = ES
ST = Catalunya
L = Barcelona
O = @42barcelona
OU = Unit
CN = localhost

[ req_ext ]
subjectAltName = @alt_names

[v3_ext]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = localhost
IP.1 = 127.0.0.1
IP.2 = 0.0.0.0
DNS.2 = vault.local

